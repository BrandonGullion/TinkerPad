{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinkerPad",
  "version": "0.1.0",
  "identifier": "io.github.brandongullion.tinkerpad",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TinkerPad",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../plugins/": "plugins/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "Brandon Gullion",
    "shortDescription": "A code playground for quick experiments",
    "longDescription": "TinkerPad is a desktop code playground: write a few lines in any language a plugin supports, press Ctrl+Enter, and see what it does \u2014 with a language server, rich output, and warm runtimes.",
    "category": "DeveloperTool",
    "copyright": "\u00a9 Brandon Gullion",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BrandonGullion/TinkerPad/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0N0QyNjdCMTFCMTVFRUEKUldUcVhyRVJleVo5ZE9Fa2JrSkYxRnp6QnRWQWd6WWd5YVJJZU44enEvbU5MRXQ3QnRJSjJFTnMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
